# OpenAI API key for fallback AI responses
# See https://platform.openai.com/docs/quickstart
OPENAI_API_KEY="your-openai-api-key"

# Local development server port (optional, defaults to 8080)
PORT=8080

# Debug mode (true/false)
DEBUG=false

# Vozy API configuration
VOZY_API_URL="https://api.vozy.ai/v2/chat/6e96ac9d-4b10-43f9-a78e-38439023510a"
VOZY_AUTH_TOKEN="your-vozy-auth-token"

# Voice assistant configuration
WELCOME_GREETING="Hola!"
SYSTEM_PROMPT="You are a helpful assistant. This conversation is being translated to voice, so answer carefully. When you respond, please spell out all numbers, for example twenty not 20. Do not include emojis in your responses. Do not include bullet points, asterisks, or special symbols."
TTS_PROVIDER="ElevenLabs"
VOICE="J4vZAFDEcpenkMp3f3R9"
NLP_LANGUAGE="es-ES"

# The following variables are automatically set during deployment
# DO NOT set these manually - they will be configured by the CloudFormation custom resource
# DOMAIN="api-gateway-domain.execute-api.region.amazonaws.com/Prod"
# WS_URL="wss://websocket-api-gateway.execute-api.region.amazonaws.com/Prod"
